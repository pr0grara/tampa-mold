---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceCards from '@components/ServiceCards.astro';
import QuoteForm from '@components/QuoteForm.astro';
import FaqSection from '@components/FaqSection.astro';
import Neighborhoods from '@components/Neighborhoods.astro';
import CommonIssues from '@components/CommonIssues.astro';
import NearbyCities from '@components/NearbyCities.astro';
import FinalCta from '@components/FinalCta.astro';
import { CITIES, nearbyCities, type City } from '@config/cities';
import { MATRIX_SERVICES } from '@config/services';
import { INDEXED_COMBO_CITIES } from '@config/indexing';
import { SITE, tel } from '@config/site';
import { getHeroUrl } from '../../lib/images';
import { cityUrl, cityServiceUrl } from '../../lib/urls';
import { breadcrumb, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

interface Props {
  city: City;
}
const { city } = Astro.props;

const heroUrl = await getHeroUrl(city.heroImage);
const where = city.state ? `${city.name}, ${city.state}` : city.name;
const near = nearbyCities(city);

const title = `Mold Remediation in ${where} | ${SITE.company}`;
const description = `Mold inspection, testing, black mold and attic removal, crawl space mold, and damage repair in ${where}. Local ${SITE.trade} — we come to your property. Call ${SITE.phoneDisplay}.`;

const jsonLd = [
  breadcrumb([
    { name: 'Home', url: '/' },
    { name: where, url: cityUrl(city) },
  ]),
];
const faqLd = faqPage(city.faqs);
if (faqLd) jsonLd.push(faqLd);
---

<BaseLayout title={title} description={description} heroPreload={heroUrl} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero-single" style={`background-image:url('${heroUrl}')`}>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>Service Area<span>/</span>{city.name}
      </nav>
      <h1>Mold Remediation in {where}</h1>
      <p>
        Mold inspection, testing, removal, and damage repair for {city.name} — we come to your
        property, find the moisture source, and fix the cause. Straight quotes and fast response when
        a leak or storm has water sitting.
      </p>
      <div class="hero-actions">
        <a class="btn btn-call btn-lg" href={tel()}>📞 Call {SITE.phoneDisplay}</a>
        <a class="btn btn-outline btn-lg" href="#quote">Get a Free Quote</a>
      </div>
    </div>
  </section>

  <!-- City intro + form -->
  <section class="section">
    <div class="container split">
      <div class="prose">
        <h2>Your {city.name} Mold Crew</h2>
        <p class="lead">{city.intro}</p>

        {
          city.landmarks.length > 0 && (
            <>
              <h3>Around {city.name}</h3>
              <ul class="chips">
                {city.landmarks.map((l) => <li>{l}</li>)}
              </ul>
            </>
          )
        }
      </div>
      <QuoteForm
        source={`city-${city.slug}`}
        heading={`Mold Help in ${city.name}`}
        sub={`Tell us where you’re seeing or smelling mold — we’ll call you back with a real answer.`}
      />
    </div>
  </section>

  <!--
    Text links to this city's indexable service/city combo pages, so the crawler has
    a plain in-content path to reach them (image cards alone are a weak discovery
    signal on a low-authority site). Gated to cities whose combos are unlocked for
    indexing — currently Clearwater only (EXP-004).
  -->
  {
    INDEXED_COMBO_CITIES.includes(city.slug) && (
      <section class="section">
        <div class="container prose">
          <h2>Mold Services We Handle in {city.name}</h2>
          <p>
            Every piece of a {city.name} mold problem, handled by the same local crew. Go straight to
            the service that fits what you are dealing with:
          </p>
          <ul class="combo-links">
            {MATRIX_SERVICES.map((s) => (
              <li>
                <a href={cityServiceUrl(s, city)}>
                  {s.name} in {city.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- All matrix services, linking to combo pages for this city -->
  <ServiceCards city={city} />

  <Neighborhoods cityName={city.name} neighborhoods={city.neighborhoods} />

  <CommonIssues cityName={city.name} issues={city.issues} />

  <NearbyCities cities={near} cityName={city.name} />

  <div class="section-soft">
    <FaqSection faqs={city.faqs} title={`Mold Remediation in ${city.name} — FAQs`} />
  </div>

  <FinalCta heading={`Mold Trouble in ${city.name}?`} />
</BaseLayout>
